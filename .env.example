# Copy to .env and fill in real values locally. Never commit the real .env file.

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_REPLICATION_FACTOR=1
EVENTS_PER_SECOND=5
BURST_PROBABILITY=0.02

# ----- Spark / Streaming -----
RAW_LAKE_PATH=data/lake/raw/transactions
BAD_RECORDS_PATH=data/lake/raw/bad_records
AGG_MINUTE_PATH=data/lake/curated/sales_by_minute
AGG_CITY_PATH=data/lake/curated/sales_by_city
AGG_PRODUCT_PATH=data/lake/curated/product_performance
ANOMALIES_PATH=data/lake/curated/anomalies
CHECKPOINT_ROOT=data/checkpoints
WATERMARK_DELAY=2 minutes
HIGH_VALUE_THRESHOLD=500.0
BURST_WINDOW=2 minutes
BURST_COUNT_THRESHOLD=5
GEO_ANOMALY_MINUTES=30
REFUND_RATE_THRESHOLD=0.5

# ----- AWS -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=retail-data-platform

# ----- Snowflake -----
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=RETAIL_LOADER
SNOWFLAKE_DATABASE=RETAIL_PLATFORM
SNOWFLAKE_WAREHOUSE=RETAIL_WH
SNOWFLAKE_URL=

# ----- Airflow -----
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
